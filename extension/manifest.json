{
  "manifest_version": 3,
  "name": "MiDescargador",
  "version": "2.5.0",
  "description": "Pestaña de descarga estilo IDM sobre cada video, con elección de resolución, que envía a MiDescargador local.",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "downloads",
    "storage",
    "cookies",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:17890/*",
    "*://*.google.com/*",
    "*://*.youtube.com/*",
    "*://*.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "exclusiones.js",
        "token.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "MiDescargador",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
