{
  "name": "midescargador",
  "version": "2.4.8",
  "description": "MiDescargador - gestor de descargas segmentado, videos y torrents",
  "main": "main.js",
  "author": "MiDescargador",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "node ../build_mei/sync-version.js && electron-builder --win",
    "dist:portable": "node ../build_mei/sync-version.js && electron-builder --win portable",
    "postinstall": "node ../build_mei/sync-version.js"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.midescargador.desktop",
    "productName": "MiDescargador",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../backend/servidor",
        "to": "backend/servidor"
      },
      {
        "from": "../extension",
        "to": "extension"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MiDescargador-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "MiDescargador-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "construacero-sistemas",
        "repo": "Midescargador"
      }
    ]
  }
}